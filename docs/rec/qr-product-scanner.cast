[122.983, "o", "\u001b[90m 812\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mmatch\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mraw.match(\u001b[33m/^PROD-\\d{5}-[A-Z0-9]{3}$/\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
[123.038, "o", "\u001b[90m 813\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!match)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
