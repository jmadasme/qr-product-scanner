[122.763, "o", "\u001b[90m 808\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m          \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(code\u001b[90m \u001b[39;49;00m&&\u001b[90m \u001b[39;49;00mcode.data)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
